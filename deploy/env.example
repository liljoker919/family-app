# Copy this file to /etc/family-app/env and fill in real values.
# This file is loaded by the gunicorn systemd service.
# Never commit the real env file — it contains secrets.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DJANGO_ALLOWED_HOSTS=your-static-ip-or-domain.com

# Optional — leave blank to disable the integration
GOOGLE_CALENDAR_CREDENTIALS=/etc/family-app/google-sa-key.json
GOOGLE_CALENDAR_ID=primary
OUTLOOK_ICAL_URL=

# Error tracking — leave blank to disable Sentry
SENTRY_DSN=

# Nightly DB backup sync — leave blank to skip the S3 upload (local backups still run)
BACKUP_S3_BUCKET=

# Postgres (Docker container on this same Lightsail instance — see deploy/docker-compose.yml)
DB_NAME=family_app
DB_USER=family_app
DB_PASSWORD=change-me-to-a-long-random-string
DB_HOST=127.0.0.1
DB_PORT=5432

# Stripe / dj-stripe — leave blank until a Stripe account exists; billing stays
# inert (no crash) with these unset. Set STRIPE_LIVE_MODE=true only when ready
# to take real payments.
STRIPE_LIVE_MODE=false
STRIPE_TEST_SECRET_KEY=
STRIPE_LIVE_SECRET_KEY=
STRIPE_TEST_PUBLIC_KEY=
STRIPE_LIVE_PUBLIC_KEY=

# Stripe Price ID for the Family ($4.99/mo) plan — create the Product/Price by
# hand in the Stripe dashboard's Products page, then paste the price_... ID
# here. Onboarding's plan-selection step stays inert until this is set.
STRIPE_FAMILY_PRICE_ID=

# Amazon SES — heyfamlyapp.com is a verified SES domain identity (see #311).
# Use a dedicated IAM user scoped to ses:SendEmail/SendRawEmail only, not the
# backup-service or admin credentials used elsewhere on this box.
DEFAULT_FROM_EMAIL=noreply@heyfamlyapp.com
AWS_SES_REGION_NAME=us-east-1
AWS_SES_REGION_ENDPOINT=email.us-east-1.amazonaws.com
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
